# Use an Analytics Token (account.upstox.com > Developer Apps > your app >
# Analytics tab > Generate Token). Read-only, valid 1 year, no daily refresh
# needed. Only one can be active per account - regenerating revokes the old one.
UPSTOX_ACCESS_TOKEN=

# Optional - Telegram alerts. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional - only needed for execution/llm_gatekeeper.py's sanity checks.
ANTHROPIC_API_KEY=
